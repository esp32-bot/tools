#!/usr/bin/env bash
# BalaX dev tool: build, flash and talk to the robot over USB or LAN.
#
#   tools/bx build                   compile (incremental, cached)
#   tools/bx flash                   build, then flash the connected robot over USB
#   tools/bx monitor                 USB serial console and logs; Ctrl+] quits
#   tools/bx run                     USB flash, then monitor
#   tools/bx cmd <command>...        run console commands over USB
#   tools/bx lan-flash [ip]          build, then cryptographically flash over LAN (PBKDF2 + HMAC-SHA256)
#   tools/bx lan-monitor [ip]        stream live logs over LAN (authenticated)
#   tools/bx lan-cmd <ip> <cmd>...   run console commands over LAN (authenticated)
#   tools/bx gui                     launch local web GUI dashboard for building, flashing, and tuning
#   tools/bx dist [stable|dev]       package firmware into web/fw/<channel>/ for GitHub Pages & OTA
#   tools/bx erase                   wipe the robot's flash, settings included
#   tools/bx test                    run the laptop tests (C++ and Python), no robot needed
#   tools/bx preview                 render the status screen to host/build/preview.png
#   tools/bx idf <args>...           any idf.py command, with ESP-IDF set up
#
# BX_PORT picks the USB serial port; BX_IP picks the default LAN IP address.
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
IDF_VERSION=v6.1.1
PINNED_IDF="$HOME/esp/$IDF_VERSION/esp-idf"
FLASH_BAUD="${BX_BAUD:-1500000}"  # the M5StickC Plus USB chip's fastest reliable rate

usage() {
  sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'
}

setup_idf() {
  if [[ "${IDF_PATH:-}" != "$PINNED_IDF" ]] || ! command -v idf.py >/dev/null; then
    if [[ ! -f "$PINNED_IDF/export.sh" ]]; then
      echo "ESP-IDF $IDF_VERSION not found at $PINNED_IDF" >&2
      exit 1
    fi
    . "$PINNED_IDF/export.sh" >/dev/null
  fi
  export IDF_CCACHE_ENABLE=1
}

# sdkconfig is generated from sdkconfig.defaults and sdkconfig.local, but ESP-IDF keeps the
# values already in it. So bx keeps a copy of what it was generated from, and starts it over
# when that changes, a deleted sdkconfig.local included.
SDKCONFIG_SOURCES="$REPO/build/sdkconfig.sources"

sdkconfig_sources() {
  cat "$REPO/sdkconfig.defaults" "$REPO/sdkconfig.local" 2>/dev/null || true
}

idf() {
  if [[ "$(cat "$SDKCONFIG_SOURCES" 2>/dev/null)" != "$(sdkconfig_sources)" ]]; then
    rm -f "$REPO/sdkconfig"
  fi
  local status=0
  idf.py -C "$REPO" "$@" || status=$?
  # Only into a CMake build directory: idf.py refuses a build/ that holds anything else.
  if [[ -f "$REPO/build/CMakeCache.txt" ]]; then
    sdkconfig_sources >"$SDKCONFIG_SOURCES"
  fi
  return "$status"
}

# ESP-IDF's Python, which has pyserial, without the second it takes to set up all of ESP-IDF.
idf_python() {
  local release="${IDF_VERSION#v}"
  release="${release%.*}"  # the env is named after major.minor: 6.1
  local found=("$HOME"/.espressif/python_env/idf"$release"_py*_env/bin/python)
  if [[ ! -x "${found[0]}" ]]; then
    echo "ESP-IDF's Python env not found in ~/.espressif/python_env" >&2
    exit 1
  fi
  echo "${found[0]}"
}

robot_port() {
  if [[ -n "${BX_PORT:-}" ]]; then
    echo "$BX_PORT"
    return
  fi
  shopt -s nullglob
  local ports=(/dev/cu.usbserial-* /dev/cu.wchusbserial*)
  case ${#ports[@]} in
    1) echo "${ports[0]}" ;;
    0) echo "No robot on USB. Plug it in and turn it on." >&2; exit 1 ;;
    *) echo "Several serial ports (${ports[*]}); pick one with BX_PORT=..." >&2; exit 1 ;;
  esac
}

# Firmware code that's plain C++, built for the laptop.
HOST_BUILD="$REPO/host/build"
SHARED_COMP="$HOME/gh/esp32-bot/tools/components"
if [[ ! -d "$SHARED_COMP" ]]; then
  SHARED_COMP="$REPO/components"
fi
HOST_FLAGS=(-std=c++23 -O2 -Wall -Wextra -Werror
  -I"$SHARED_COMP/gfx/include" -I"$SHARED_COMP/m5stickc_plus/include" -I"$REPO/main")

# The firmware's plain C++ logic, tested on the laptop.
HOST_TESTED=("$REPO/main/balance.cpp" "$REPO/main/remote_protocol.cpp")

host_tests() {
  mkdir -p "$HOST_BUILD"
  c++ "${HOST_FLAGS[@]}" -I"$REPO/host" "$REPO"/host/tests.cpp "$REPO"/host/test_*.cpp "${HOST_TESTED[@]}" \
    -o "$HOST_BUILD/tests"
  "$HOST_BUILD/tests"
}

preview() {
  mkdir -p "$HOST_BUILD"
  c++ "${HOST_FLAGS[@]}" "$REPO/host/preview.cpp" "$REPO/main/status_view.cpp" "$SHARED_COMP/gfx/canvas.cpp" \
    -lz -o "$HOST_BUILD/preview"
  "$HOST_BUILD/preview" "$HOST_BUILD/preview.png"
  echo "$HOST_BUILD/preview.png"
}

# Flash and monitor through the environment, not -p/-b: a -b would also set the monitor's
# baud rate, which has to stay at the console's.
with_robot() {
  ESPPORT="$(robot_port)" ESPBAUD="$FLASH_BAUD" idf "$@"
}

command="${1:-}"
shift || true
case "$command" in
  build)       setup_idf; idf build ;;
  flash)       setup_idf; with_robot flash ;;
  monitor)     setup_idf; with_robot monitor ;;
  run)         setup_idf; with_robot flash monitor ;;
  erase)       setup_idf; with_robot erase-flash ;;
  idf)         setup_idf; idf "$@" ;;
  cmd)         "$(idf_python)" "$REPO/tools/console.py" --port "$(robot_port)" "$@" ;;
  lan-flash)   setup_idf; idf build; python3 "$REPO/tools/lan.py" flash "$@" ;;
  lan-monitor) python3 "$REPO/tools/lan.py" monitor "$@" ;;
  lan-cmd)     python3 "$REPO/tools/lan.py" cmd "$@" ;;
  gui)         python3 "$REPO/tools/gui.py" "$@" ;;
  dist)        python3 "$REPO/tools/dist.py" --channel "${1:-dev}" ;;
  test)        host_tests; "$(idf_python)" -B -m unittest discover -s "$REPO/tools" "$@" ;;
  preview)     preview ;;
  ""|help|-h|--help) usage ;;
  *)           usage >&2; exit 1 ;;
esac
